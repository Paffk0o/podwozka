# Skopiuj do .env (plik .env NIE trafia do repo).
# Lokalnie wszystko działa z wartościami domyślnymi z docker-compose.yml — klucze poniżej
# są potrzebne dopiero dla płatności, map i monitoringu.

# Stripe (tryb testowy) — https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Maps Platform — klucz SERWEROWY (Routes API, Places API (New), Geocoding)
GOOGLE_MAPS_SERVER_KEY=

# Sentry (opcjonalnie)
SENTRY_DSN=
